---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { samplePosts } from '../../data/themePreview';
---
<BaseLayout title="主题预览"><section class="home-intro"><p class="eyebrow">WELCOME / 欢迎来坐坐</p><h1>日常的边上，<br /><em>总有一些番外。</em></h1><p>这里是本地设计预览。以下文章完全虚构，用来检查真实列表的密度、日期与阅读排版。</p><a class="inline-link" href="/preview/blog/">去看看文章 <span>↗</span></a></section><section class="home-categories"><div class="section-heading"><div><p class="eyebrow">EXPLORE</p><h2>随意逛逛</h2></div><a href="/preview/category/">所有分类 ↗</a></div><div class="category-tiles"><a href="/preview/category/">生活随笔 <span>日子里的小片段</span></a><a href="/preview/category/">阅读与影视 <span>读过、看过、想过</span></a><a href="/preview/category/">技术与创作 <span>小项目和新发现</span></a></div></section><section class="home-recent"><div class="section-heading"><div><p class="eyebrow">LATEST STORIES</p><h2>最近写下的</h2></div><a href="/preview/blog/">全部文章 ↗</a></div><PostList posts={samplePosts.slice(0,3)} preview /></section></BaseLayout>
