---
import FormattedDate from './FormattedDate.astro';
interface Props { posts: any[]; }
const { posts } = Astro.props;
---
{posts.length === 0 ? <p class="empty-state">文章正在路上。先在这里坐一会儿吧。</p> : <div class="post-list">
  {posts.map((post) => {
    const url = `/blog/${post.data.slug}/`;
    return <article class="post-card">
      <div class="post-card-body">
        <h2><a class="post-title-link" href={url}><span class="post-title-text" transition:name={`post-title-${post.data.slug}`}>{post.data.title}</span><span class="post-inline-arrow" aria-hidden="true">›</span></a></h2>
        <div class="post-meta"><FormattedDate date={post.data.pubDate} /><span class="meta-dot">·</span><a href={`/category/${encodeURIComponent(post.data.category)}/`}>{post.data.category}</a><span class="post-card-tags">{post.data.tags.map((tag: string) => <a href={`/tag/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</span></div>
        <p class="post-summary">{post.data.description}</p>
      </div>
      <a class="post-entry post-enter" href={url} aria-label={`阅读：${post.data.title}`}><span aria-hidden="true">›</span></a>
    </article>;
  })}
</div>}
